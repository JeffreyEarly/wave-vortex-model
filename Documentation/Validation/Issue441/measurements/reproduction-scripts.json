      "sourceRelativeToEvidenceRoot": "recovery/pinnedAPVv2.m",
      "sha256": "767e7329f0586bd0a8772ff488e23977ae15168efb7777b4a8c08079714fecf8",
      "source": "% Recreate the historical APV workload in a fresh guarded MATLAB process.\n% The released historical pins remain separate from the current beta.5 path.\nworkspaceRoot = \"/Users/jearly/Documents/OceanKitRepositories\";\nevidenceRoot = fullfile(workspaceRoot,\"thermal-readiness-t10-evidence\");\npinnedWorkspace = fullfile(evidenceRoot,\"pinned\");\nexperimentRoot = fullfile(workspaceRoot,\"free-surface-qg-experiments\");\nauthoringTools = fullfile(workspaceRoot,\"wave-vortex-model\",\"tools\");\noutputDirectory = fullfile(evidenceRoot,\"pinned-apv-cold-v2\");\nif isfolder(outputDirectory)\n    error('WV:ReadinessPinnedEvidence','Choose a new output directory; existing evidence is immutable: %s.',outputDirectory);\nend\ncd(pinnedWorkspace);\nrestoredefaultpath;\naddpath(experimentRoot);\ndependencies = setupExperiment(pinnedWorkspace);\naddpath(authoringTools);\nresolvedPaths = strings(numel(dependencies),1);\nfor dependencyIndex = 1:numel(dependencies)\n    dependency = dependencies(dependencyIndex);\n    resolvedPaths(dependencyIndex) = string(which(dependency.symbol));\n    expectedPrefix = fullfile(pinnedWorkspace,dependency.directory)+filesep;\n    if ~startsWith(resolvedPaths(dependencyIndex),expectedPrefix)\n        error('WV:ReadinessPinnedEnvironment','%s resolves outside its isolated historical checkout: %s.',dependency.symbol,resolvedPaths(dependencyIndex));\n    end\n    fprintf('%s: %s\\n',dependency.symbol,resolvedPaths(dependencyIndex));\nend\nexpectedBenchmark = fullfile(authoringTools,\"benchmarkPinnedThermalReadinessAPV.m\");\nif string(which('benchmarkPinnedThermalReadinessAPV'))~=expectedBenchmark\n    error('WV:ReadinessPinnedEnvironment','The authoring benchmark does not resolve to %s.',expectedBenchmark);\nend\nmkdir(outputDirectory);\npathProvenance = struct(matlabVersion=string(version),platform=string(computer),dependencies=dependencies,resolvedPaths=resolvedPaths,benchmarkPath=expectedBenchmark);\nfid = fopen(fullfile(outputDirectory,\"resolved-paths.json\"),'w');\nif fid<0\n    error('WV:ReadinessPinnedEvidence','Cannot write resolved path provenance.');\nend\nfileCleanup = onCleanup(@()fclose(fid));\nfwrite(fid,jsonencode(pathProvenance,PrettyPrint=true));\nclear fileCleanup\nreport = benchmarkPinnedThermalReadinessAPV(outputDirectory,duration=21600,maximumWallSeconds=900);\nfprintf('Pinned APV status: %s\\nReason: %s\\n',report.status,report.reason);\nif report.status~=\"MEASURED CONTROL\"\n    error('WV:ReadinessPinnedIncomplete','Historical APV baseline was not fully measured: %s.',report.reason);\nend\n"
    },
