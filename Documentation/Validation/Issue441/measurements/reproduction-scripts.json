      "source": "run('/Users/jearly/Documents/OceanKitRepositories/thermal-readiness-t10-evidence/recovery/setup.m');\nevidence=fullfile(root,'thermal-readiness-t10-evidence');cache=load(fullfile(evidence,'scientific64.mat'));\n[w,manifest]=thermalReadinessCase(struct(velocityRMS=.01,seasonalM=10,phase=pi/2),scientificState=cache.scientificState);\nmodel=WVModel(w);model.setupIntegrator(integratorType=\"exponential\",initialStep=900,maximumStep=900,exponentialAdaptive=false);model.explicitFlux();\nfolder=fullfile(evidence,'profile64');mkdir(folder);\ntimings=table();for repetition=1:5\n    [~,~,t]=w.nonlinearCoefficientTendency();\n    timings=[timings;table(repetition,t.reconstructionSeconds,t.productSeconds,t.projectionSeconds,t.scratchBytesEstimate,t.radiusGroups,VariableNames={'repetition','reconstructionSeconds','productSeconds','projectionSeconds','scratchBytesEstimate','radiusGroups'})];\nend\nwritetable(timings,fullfile(folder,'nonlinear-components.csv'));\naddpath(fullfile(root,'OceanKit','tools','profiling'));\nanalysis=profileCodeHotspots(@()model.explicitFlux(),projectRoots=pwd,shouldPrintReport=false);\nsave(fullfile(folder,'profile.mat'),'analysis','manifest','-v7.3');\nfor name=[\"priorityTargets\",\"topProjectBySelfTime\",\"topProjectByNumCalls\",\"topActionableLines\",\"topCallsiteLines\"],writetable(analysis.(name),fullfile(folder,name+\".csv\"));end\n"
    },
