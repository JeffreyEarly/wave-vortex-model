      "source": "restoredefaultpath;\nroot='/Users/jearly/Documents/OceanKitRepositories';cd(fullfile(root,'wave-vortex-model'));addpath('tools');\nconfigureCIEnvironment(pwd,fullfile(root,'OceanKit'));\np=string(strsplit(path,pathsep));bad=contains(p,'/internal-modes');if any(bad),rmpath(char(join(p(bad),pathsep)));end\nassert(contains(which('IMInternalModes'),'/InternalModes-2.0.0-beta.5/'));\nassert(numel(which('IMInternalModes','-all'))==1);maxNumCompThreads(4);\nevidence=fullfile(root,'thermal-readiness-t10-evidence');\ncache=load(fullfile(evidence,'scientific64.mat'));w=WVTransformFreeSurfaceThermalQG(scientificState=cache.scientificState,coefficientState=cache.coefficientState,t=cache.manifest.configuration.t);\nrecord=struct(caseId=cache.manifest.caseId,recordId=\"manufactured-initial\",state=w.coefficientState(),time=w.t,forcingMultiplier=10,seasonalPhase=0,regime=\"capacity-only\");\nr=qualifyThermalReadinessDiagnostics(w,record,fullfile(evidence,'diagnostic64-initial'),diagnosticBasisDirectory=fullfile(evidence,'diagnostic-bases64'));disp(r.summary);\nclock=tic;integralN2=w.N20*(-expm1(-2*w.inverseScale*w.Lz))/(2*w.inverseScale);\napv=WVTransformFreeSurfaceQG([w.Lx w.Ly w.Lz],[64 64 129],N2Function=w.N2Function,g=w.g,latitude=w.latitude,rho0=w.rho0,g0=-integralN2,gd=integralN2,apvModeCount=6,mdaModeCount=1,shouldAntialias=true,shouldCheckQuadraticAliasing=false);\nf=WVThermalAPVDamping.fromAPVTransform(w,apv,apvCutoffFraction=.5);canonical=struct();for name=string(f.classRequiredPropertyNames()),canonical.(name)=f.(name);end;closureSetupSeconds=toc(clock);\nsave(fullfile(evidence,'closure64.mat'),'canonical','closureSetupSeconds','-v7.3');\n"
